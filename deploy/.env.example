# 本地配置备忘模板（可提交；真实值请写进同目录 .env，已被 .gitignore 排除）
# 阿里云盘 refresh_token：只填到 AList 后台「存储 → 添加 → 阿里云盘 Open → 刷新令牌」
ALIPAN_REFRESH_TOKEN=your_refresh_token_here

# AList 管理员账号（首次启动后用 docker exec 设置密码，见页面「使用说明」）
ALIST_ADMIN_USER=admin
ALIST_ADMIN_PASSWORD=change-me

# 填进驿站系统「设置与数据 → 图片存储 → WebDAV 地址」的值。
# GitHub Pages 是 https，这里也必须是 https + 允许跨域，否则浏览器会拦截。
WEBDAV_URL=https://dav.example.com/dav
